generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  steamId     String?  @unique
  username    String   @default("Игрок")
  avatar      String?
  balance     Int      @default(1000)
  totalWon    Int      @default(0)
  createdAt   DateTime @default(now())
  lastSeen    DateTime @default(now())
  inventory   InventoryItem[]
  drops       Drop[]
  upgrades  Upgrade[]
}

model InventoryItem {
  id        String   @id @default(cuid())
  userId    String
  name      String
  rarity    String
  price     Int
  color     String
  caseName  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Drop {
  id        String   @id @default(cuid())
  userId    String
  name      String
  price     Int
  color     String
  caseName  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Visitor {
  id        String   @id
  lastSeen  DateTime @default(now())
}

model Item {
  id         String   @id @default(cuid())
  name       String
  image      String
  price      Float
  rarity     String?  @default("Common")
  color      String?  @default("#888888")
  steamUrl   String?  @unique
  marketHash String?  @unique
  statTrak   Boolean  @default(false)
  condition  String   @default("FT")
  createdAt  DateTime @default(now())
  caseItems  CaseItem[]
}

model Case {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  image       String?
  items       CaseItem[]
  createdAt   DateTime @default(now())
}

model CaseItem {
  id        String   @id @default(cuid())
  caseId    String
  itemId    String
  
  // Связи
  item      Item     @relation(fields: [itemId], references: [id])
  case      Case     @relation(fields: [caseId], references: [id])
  
  dropRate  Float    @default(1.0)
  createdAt DateTime @default(now())
}
model Upgrade {
  id        String   @id @default(cuid())
  userId    String
  fromName  String
  fromPrice Float
  fromImage String
  toName    String
  toPrice   Float
  toImage   String
  won       Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}